  "tokenColors": [
    { "name": "Default", "settings": { "foreground": "#D4D4D4", "background": "#171717" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#919191", "fontStyle": "" } },
    { "name": "Strings and inline code", "scope": ["string", "constant.character", "markup.inline.raw", "markup.raw"], "settings": { "foreground": "#D4D4D4" } },
    { "name": "Numbers and constants", "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#A0A0A0" } },
    { "name": "Keywords", "scope": ["keyword", "storage", "meta.preprocessor"], "settings": { "foreground": "#D4D4D4" } },
    { "name": "Functions and variables", "scope": ["entity.name.function", "support.function", "variable", "variable.parameter"], "settings": { "foreground": "#D4D4D4" } },
    { "name": "Types", "scope": ["entity.name.type", "support.type", "entity.name.class", "support.class"], "settings": { "foreground": "#B8B8B8" } },
    { "name": "Punctuation and operators", "scope": ["punctuation", "keyword.operator"], "settings": { "foreground": "#A0A0A0" } },
    { "name": "Headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#D4D4D4", "fontStyle": "bold" } },
    { "name": "Links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#B0B0B0", "fontStyle": "underline" } },
    { "name": "Strong text", "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "name": "Emphasized text", "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "name": "Inserted text", "scope": "markup.inserted", "settings": { "foreground": "#D4D4D4" } },
    { "name": "Deleted text", "scope": "markup.deleted", "settings": { "foreground": "#F25623", "fontStyle": "bold underline" } },
    { "name": "Errors", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F25623", "fontStyle": "bold underline" } },
    { "name": "Deprecated", "scope": "invalid.deprecated", "settings": { "foreground": "#F56E0F", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "*": { "foreground": "#D4D4D4" },
    "comment": { "foreground": "#919191", "italic": false },
    "string": { "foreground": "#D4D4D4" },
    "regexp": { "foreground": "#D4D4D4" },
    "number": { "foreground": "#A0A0A0" },
    "operator": { "foreground": "#A0A0A0" },
    "keyword": { "foreground": "#D4D4D4" },
    "type": { "foreground": "#B8B8B8" },
    "class": { "foreground": "#B8B8B8" },
    "interface": { "foreground": "#B8B8B8" },
    "enum": { "foreground": "#B8B8B8" },
    "namespace": { "foreground": "#B8B8B8" },
    "function": { "foreground": "#D4D4D4" },
    "method": { "foreground": "#D4D4D4" },
    "variable": { "foreground": "#D4D4D4" },
    "parameter": { "foreground": "#D4D4D4" },
    "property": { "foreground": "#D4D4D4" }
  }
